---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { bio, highlights, listen, social, site, tracks, campaign, formatDate } from '../../data/site';
const logos = [
  { label: 'Primary badge', src: site.logo.primary },
  { label: 'Wordmark', src: site.logo.wordmark },
  { label: 'Monogram', src: site.logo.monogram },
  { label: 'The Fruit Of Love lockup', src: site.logo.stacked },
];
---
<Layout title="EPK" description="LJ Bey press kit: bios, verified highlights, links, campaign summary, brand assets and contact." image={site.logo.primary}>
  <PageHero eyebrow="Press kit" title="LJ Bey EPK" mandala="mandala-crown" tint="#efe4fb">
    <a class="btn btn-gold mt-6" href="/epk/one-sheet/">Printable one-sheet</a>
  </PageHero>
  <div class="wrap mt-10 grid gap-10 lg:grid-cols-[2fr_1fr]">
    <div class="space-y-10">
      <section><h2 class="text-2xl">Short bio</h2><p class="mt-3 leading-relaxed">{bio.short}</p></section>
      <section><h2 class="text-2xl">Long bio</h2><p class="mt-3 leading-relaxed">{bio.long}</p></section>
      <section><h2 class="text-2xl">Highlights</h2><ul class="mt-3 space-y-2 list-disc pl-5">{highlights.map((h) => <li>{h}</li>)}</ul></section>
      <section>
        <h2 class="text-2xl">The Fruit Of Love</h2>
        <p class="mt-3 leading-relaxed">{tracks.length} songs released as weekly singles from {formatDate(campaign.firstSingle, { month: 'long', day: 'numeric', year: 'numeric' })} through {formatDate(campaign.lastSingle, { month: 'long', day: 'numeric', year: 'numeric' })}, with the full album on {formatDate(campaign.albumDate, { month: 'long', day: 'numeric', year: 'numeric' })}. <a class="link" href="/the-fruit-of-love/">See the schedule</a>.</p>
      </section>
    </div>
    <aside class="space-y-8">
      <section><h2 class="text-xl">Listen</h2><ul class="mt-2 space-y-1">{listen.map((l) => <li><a class="link" href={l.href} rel="noopener">{l.label}</a></li>)}</ul></section>
      <section><h2 class="text-xl">Social</h2><ul class="mt-2 space-y-1">{social.map((l) => <li><a class="link" href={l.href} rel="noopener">{l.label}</a></li>)}</ul></section>
      <section><h2 class="text-xl">Contact</h2><p class="mt-2"><a class="link break-all" href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a></p></section>
    </aside>
  </div>
  <section class="wrap mt-12">
    <h2 class="text-2xl">Brand assets</h2>
    <div class="mt-4 grid grid-cols-2 lg:grid-cols-4 gap-4">
      {logos.map((l) => (
        <a class="card block" href={l.src} download>
          <img src={l.src.replace('/assets/', '/assets/thumbs/')} alt={`LJ Bey logo: ${l.label}`} width="640" height="640" loading="lazy" class="w-full aspect-square object-contain bg-cream" />
          <p class="p-3 text-sm font-bold">{l.label} <span class="font-normal text-soft">· Download</span></p>
        </a>
      ))}
    </div>
  </section>
</Layout>
