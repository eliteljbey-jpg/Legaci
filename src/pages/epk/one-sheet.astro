---
import Layout from '../../layouts/Layout.astro';
import { bio, highlights, listen, site, tracks, campaign, formatDate } from '../../data/site';
---
<Layout title="One-Sheet" bare>
  <div class="sheet">
    <div class="no-print mb-4 flex gap-3">
      <button class="btn btn-gold" id="print">Print or save as PDF</button>
      <a class="btn btn-line" href="/epk/">Back to EPK</a>
    </div>
    <div class="spectrum-bar"></div>
    <header class="flex items-center gap-4 mt-3">
      <img src={site.logo.primary.replace('/assets/', '/assets/thumbs/')} alt="LJ Bey logo" width="84" height="84" class="logo-crop" />
      <div>
        <h1 class="text-4xl">LJ Bey</h1>
        <p class="text-sm font-semibold">R&amp;B · Hip-Hop · RnBass · Producer · Sacramento, California</p>
      </div>
    </header>
    <p class="mt-3 text-[.92rem] leading-snug">{bio.long}</p>
    <h2 class="mt-3 text-lg">Highlights</h2>
    <ul class="mt-1 list-disc pl-5 text-[.86rem] leading-snug space-y-0.5">{highlights.map((h) => <li>{h}</li>)}</ul>
    <h2 class="mt-3 text-lg">The Fruit Of Love</h2>
    <p class="text-[.9rem] leading-snug">{tracks.length} weekly singles, {formatDate(campaign.firstSingle)} to {formatDate(campaign.lastSingle)}. Full album {formatDate(campaign.albumDate, { month: 'long', day: 'numeric', year: 'numeric' })}.</p>
    <h2 class="mt-3 text-lg">Listen</h2>
    <ul class="text-[.82rem] leading-snug">{listen.map((l) => <li><b>{l.label}:</b> {l.href.replace('https://', '')}</li>)}</ul>
    <p class="mt-3 font-bold text-[.92rem]">Booking, sync and press: {site.contactEmail} · ljbey.com</p>
  </div>
</Layout>
<style>
  .sheet { max-width: 8.5in; margin: 0 auto; padding: .5in; background: #fff; }
  @media print {
    @page { size: letter; margin: 0; }
    .sheet { padding: .45in; }
    .spectrum-bar { print-color-adjust: exact; -webkit-print-color-adjust: exact; }
  }
</style>
<script>
  document.getElementById('print')?.addEventListener('click', () => window.print());
</script>
