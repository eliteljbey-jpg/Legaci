---
import Img from './Img.astro';
interface Props { eyebrow?: string; title: string; lede?: string; mandala?: string; tint?: string }
const { eyebrow, title, lede, mandala = 'mandala-sacral', tint = '#fdeecf' } = Astro.props;
---
<section class="relative overflow-hidden" style={`background: linear-gradient(160deg, ${tint}, #fff8ea 75%)`}>
  <Img src={`/assets/${mandala}.webp`} alt="" eager class="mandala-bg -right-24 -top-24 w-[26rem] md:w-[34rem] h-auto" sizes="34rem" />
  <div class="wrap relative py-12 md:py-20">
    {eyebrow && <p class="eyebrow mb-3">{eyebrow}</p>}
    <h1 class="text-4xl md:text-6xl max-w-3xl">{title}</h1>
    {lede && <p class="lede mt-4 max-w-2xl">{lede}</p>}
    <slot />
  </div>
</section>
