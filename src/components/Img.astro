---
// Serves a 640px copy to small screens and the full file to large ones.
interface Props { src: string; alt: string; class?: string; sizes?: string; eager?: boolean; width?: number; height?: number }
const { src, alt, class: cls, sizes = '(min-width: 768px) 33vw, 100vw', eager = false, width = 1600, height = 1600 } = Astro.props;
const thumb = src.replace('/assets/', '/assets/thumbs/');
---
<img src={thumb} srcset={`${thumb} 640w, ${src} 1600w`} sizes={sizes} alt={alt} width={width} height={height}
  loading={eager ? 'eager' : 'lazy'} decoding="async" class={cls} />
